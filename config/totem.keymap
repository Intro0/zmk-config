#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Num         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    // Callum-style oneshot mods using sticky keys
    // Configured per ZMK docs for callum-style mods
    &sk {
        release-after-ms = <2000>; // 2 seconds - generous timeout
        quick-release;             // Release immediately after next key press
        lazy;                      // Wait to activate until next key (prevents accidental GUI menu)
        ignore-modifiers;          // Allow stacking multiple oneshot mods
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <22 23>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <7 8>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <29 28>;
        };

        hyper {
            bindings = <&kp LS(LA(LC(LEFT_GUI)))>;
            key-positions = <34 35>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
                       &kp Q  &kp W  &kp E             &kp R      &kp T    &kp Y  &kp U      &kp I      &kp O    &kp P
                       &kp A  &kp S  &kp D             &kp F      &kp G    &kp H  &kp J      &kp K      &kp L    &kp SEMI
&kp LS(LA(LG(LCTRL)))  &kp Z  &kp X  &kp C             &kp V      &kp B    &kp N  &kp M      &kp COMMA  &kp DOT  &kp SLASH  &kp APOSTROPHE
                                     &kp LEFT_COMMAND  &kp SPACE  &mo 1    &mo 2  &kp LSHFT  &kp RALT
            >;
        };

        Num {
            bindings = <
       &kp FSLH      &kp N7  &kp N8  &kp N9  &kp LS(PLUS)    &kp C_VOLUME_DOWN  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_VOLUME_UP
       &kp LS(STAR)  &kp N4  &kp N5  &kp N6  &kp MINUS       &kp LEFT           &kp DOWN        &kp UP            &kp RIGHT   &none
&none  &kp N0        &kp N1  &kp N2  &kp N3  &kp EQUAL       &none              &none           &none             &none       &none            &none
                             &trans  &trans  &trans          &trans             &trans          &trans
            >;
        };

        Sym {
            bindings = <
       &kp LS(EXCL)  &kp LS(AT)    &kp LS(POUND)  &kp LS(DLLR)  &kp LS(PRCNT)    &kp LS(CARET)  &kp LS(AMPS)   &kp LS(STAR)  &kp GRAVE     &kp LS(TILDE)
       &kp LS(LT)    &kp LS(LPAR)  &kp LBKT       &kp LS(LBRC)  &kp FSLH         &kp BSLH       &kp LS(RBRC)   &kp RBKT      &kp LS(RPAR)  &kp LS(GT)
&none  &sk LGUI      &sk LALT      &sk LCTRL      &sk LSHFT     &none            &none          &kp LS(UNDER)  &kp MINUS     &kp LS(PLUS)  &kp EQUAL      &kp LS(PIPE)
                                   &trans         &trans        &trans           &trans         &trans         &trans
            >;
        };
    };
};
