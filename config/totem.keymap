#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define SYM 1
#define NUM 2
#define ADJ 3

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <120>;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <MINUS BACKSPACE>;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
        };

        layer_adj {
            bindings = <&mo ADJ>;
            key-positions = <34 35>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEF {
            display-name = "Base";
            bindings = <
                &kp Q                   &kp W       &kp E       &kp R        &kp T          &kp Y        &kp U        &kp I           &kp O         &kp P
                &hm LS(LA(LC(LGUI))) A  &kp S       &kp D       &kp F        &kp G          &kp H        &kp J        &kp K           &kp L         &kp SEMI
                &kp LS(LA(LC(LGUI)))    &kp Z       &hm LGUI X  &hm LALT C  &hm LCTRL V  &kp B          &kp N        &hm RCTRL M  &hm RALT COMMA  &hm RGUI DOT  &kp FSLH  &kp SQT
                                              &kp LGUI    &kp SPACE    &lt NUM TAB    &lt SYM RET  &kp RSHFT    &kp BSPC
            >;
        };

        SYM {
            display-name = "Symbols";
            bindings = <
                &kp HASH   &kp AT     &kp DLLR  &kp PRCNT  &kp CARET    &trans  &kp RPAR   &kp RBRC  &kp LBKT  &kp RBKT
                &kp TILDE  &kp AMPS   &kp PIPE  &kp EXCL   &kp ASTRK    &trans  &kp EQUAL  &kp LPAR  &kp LBRC  &kp COLON
                &none &kp UNDER  &kp GRAVE  &kp SEMI  &kp PLUS   &kp BSLH     &trans  &kp MINUS  &kp LT    &kp GT    &kp FSLH  &none
                                      &trans    &trans     &trans       &trans  &trans     &trans
            >;
        };

        NUM {
            display-name = "Num+Nav";
            bindings = <
                &kp MINUS  &kp N7  &kp N8  &kp N9  &kp FSLH        &kp HOME  &kp PG_DN          &kp PAGE_UP   &kp END        &kp ESC
                &kp PLUS   &kp N4  &kp N5  &kp N6  &kp EQUAL       &kp LEFT  &kp DOWN           &kp UP_ARROW  &kp RIGHT      &none
                &none &kp N0     &kp N1  &kp N2  &kp N3  &kp ASTERISK    &none     &kp RIGHT_CONTROL  &kp LALT      &kp RIGHT_GUI  &kp LSHFT &none
                                     &trans  &trans  &trans          &trans    &trans             &trans
            >;
        };

        ADJ {
            display-name = "System";
            bindings = <
                &kp F1        &kp F2        &kp F3        &kp F4      &kp F5            &kp F6                &kp F7          &kp F8            &kp F9        &kp F10
                &kp F11       &kp F12       &none         &none       &none             &kp C_BRIGHTNESS_DEC  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT    &kp C_BRIGHTNESS_INC
                &none &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &bt BT_CLR_ALL    &none                 &kp C_VOL_DN    &kp C_MUTE        &kp C_VOL_UP  &bootloader &none
                                           &trans        &trans      &trans            &trans                &trans          &trans
            >;
        };

    };
};
